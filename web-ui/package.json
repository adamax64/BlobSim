{
  "name": "web-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "vite --port=3000 --host 0.0.0.0",
    "build": "vite build",
    "serve": "vite preview",
    "start": "vite --host 0.0.0.0",
